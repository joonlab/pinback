<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 장소 저장 = 정확한 위치. 차 블루투스가 끊길 때(앱이 닫혀 있어도) 저장하려면 백그라운드 위치 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- 차 블루투스 이름·주소 읽기 (Android 12+ 근처 기기 / 11 은 옛 BLUETOOTH) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 역지오코딩(Geocoder)이 주소를 받아 올 때만 쓴다 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 길찾기 대체 경로 판단(설치 여부) — Android 11+ 패키지 가시성 -->
    <queries>
        <package android:name="com.nhn.android.nmap" />
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Pinback"
        android:supportsRtl="true">

        <!-- 폴드: 접힘·펼침 크기 변화를 스스로 감당한다 -->
        <meta-data android:name="android.supports_size_changes" android:value="true" />

        <!-- 홈 목록. 바로가기 「지금 위치 저장」·알림 「사진 남기기」도 여기로 온다(singleTop → onNewIntent) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 화면 없는 길찾기 — 바로가기 「마지막 장소로 길찾기」·알림 「길찾기」 -->
        <activity
            android:name=".NavActivity"
            android:exported="true"
            android:taskAffinity="kr.joonlab.pinback.nav"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!-- 차 블루투스 끊김 = 주차. ACL_DISCONNECTED 는 암시적 브로드캐스트 예외라 앱이 죽어 있어도 온다 -->
        <receiver
            android:name=".ParkingReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
